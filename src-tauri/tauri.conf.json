{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiftDrop",
  "version": "0.4.1",
  "identifier": "com.vitorkloy.shiftdrop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "radial",
        "title": "ShiftDrop",
        "url": "index.html",
        "width": 218,
        "height": 218,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Shift + arrastar para converter arquivos",
    "longDescription": "ShiftDrop: segure Shift enquanto arrasta um arquivo para abrir um menu radial de conversões locais (imagem, vídeo, áudio, PDF).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "imagemagick"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMEFBQUIxOTI3MkQ3OTEKUldTUjEzS1NzYW9La2FsWlVMTGh3bVhaNzNnOVdLb3lwUDlKZU1qR0dDYWFTaEZuMmhmVnhncEUK",
      "endpoints": [
        "https://github.com/vitorkloy/shiftdrop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}